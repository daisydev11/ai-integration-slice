# Copy this file to .env and fill in the values BY HAND. Never commit .env,
# and never let an AI agent write a real key into it.

# PostgreSQL connection string. From your Neon/Supabase project settings,
# or a local Postgres. The ?schema=ai part keeps this slice in its own schema.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=ai"
DATABASE_URL=

# Public base URL of the app, used in emails.
# APP_URL="http://localhost:3000"
APP_URL=

# Gemini API key, from Google AI Studio (https://aistudio.google.com/apikey).
# Type or paste it here yourself.
# GEMINI_API_KEY="AIza..."
GEMINI_API_KEY=

# Leave empty to call the real Gemini API. Set to the local simulator's
# address to develop and test without spending anything.
# GEMINI_BASE_URL="http://localhost:4020"
GEMINI_BASE_URL=

# Local development stand-in for object storage: a folder on disk.
# Defaults to ./storage (git-ignored) when empty.
# STORAGE_DIR="./storage"
STORAGE_DIR=

# Resend API key (https://resend.com/api-keys). Leave empty in local
# development: emails are then printed to the server terminal instead of sent.
# RESEND_API_KEY="re_xxxxxxxx"
RESEND_API_KEY=

# The "from" address for emails. Needed only with a Resend key.
# EMAIL_FROM="AI Slice <onboarding@resend.dev>"
EMAIL_FROM=
